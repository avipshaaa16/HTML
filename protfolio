<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Student Portfolio</title>
    <link rel="stylesheet" href="styles.css">
</head>
<style>
    /* General page styling */
    body {
        font-family: 'Arial', sans-serif;
        margin: 0;
        padding: 0;
        background: #fdf6f0;
        /* soft background */
        color: #333;
    }

    header {
        background: #4a148c;
        /* deep purple for creativity */
        color: white;
        padding: 20px;
        text-align: center;
    }

    nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        justify-content: center;
        gap: 20px;
    }

    nav ul li a {
        color: white;
        text-decoration: none;
        font-weight: bold;
    }

    section {
        padding: 40px;
        max-width: 900px;
        margin: auto;
    }

    h2 {
        color: #4a148c;
        border-bottom: 2px solid #ccc;
        padding-bottom: 10px;
    }

    .gallery {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .gallery img {
        width: 200px;
        height: auto;
        border: 3px solid #4a148c;
        border-radius: 8px;
        transition: transform 0.3s;
    }

    .gallery img:hover {
        transform: scale(1.05);
    }

    footer {
        background: #4a148c;
        color: white;
        text-align: center;
        padding: 10px;
    }

    /* Music links */
    #music ul {
        list-style: none;
        padding: 0;
    }

    #music ul li {
        margin: 10px 0;
    }

    #music ul li a {
        color: #4a148c;
        text-decoration: none;
    }

    #music ul li a:hover {
        text-decoration: underline;
    }
</style>

<body>
    <!-- Header -->
    <header>
        <h1>My Creative Journey</h1>
        <nav>
            <ul>
                <li><a href="#about">About Me</a></li>
                <li><a href="#art">Art</a></li>
                <li><a href="#music">Music</a></li>
                <li><a href="#school">School Projects</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- About Section -->
    <section id="about">
        <h2>About Me</h2>
        <p>Hi! I’m Avipsha , a 9th grader who loves exploring creativity through both music and art.
            I enjoy painting, sketching, and experimenting with digital art, as well as composing
            and performing music. This portfolio is a glimpse into my world of imagination.</p>
    </section>

    <!-- Art Section -->
    <section id="art">
        <h2>My Art</h2>
        <p>Some of my favorite artworks:</p>
        <div class="gallery">
            <img src="https://th.bing.com/th/id/R.e5dcfcbd44c24b6fc0047280abb600f0?rik=ip6u0AcuvCUcsg&pid=ImgRaw&r=0"
                alt="Artwork 1">
            <img src="https://i.pinimg.com/originals/3a/e1/aa/3ae1aa09b8f793e674e776605de94e0b.jpg" alt="Artwork 2">
        </div>
    </section>

    <!-- School Projects Section -->
    <section id="school">
        <h2>School Projects</h2>
        <p>Creative assignments and projects I’ve worked on in school:</p>
        <ul>
            <li>Art Exhibition Poster Design</li>
            <li>Music Performance for Annual Day</li>
            <li>Science Fair Project with Artistic Presentation</li>
        </ul>
    </section>
    <!-- Footer -->
    <footer>
        <p> My Creative Portfolio</p>
    </footer>
</body>

</html>